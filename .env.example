# Copia este archivo a .env y completa los valores. No subas el .env a GitHub.
# Los nombres pueden cambiar según las tecnologías que elija el equipo.

# Conexión a PostgreSQL
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/ecoruta

# Firma de sesiones o tokens (usa un valor largo y aleatorio)
JWT_SECRET=cambiar-por-un-valor-secreto

# Dirección del frontend permitida por el backend (CORS)
FRONTEND_URL=http://localhost:3000

# Administrador inicial (lo usa el script de creación)
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambiar-esta-contrasena
